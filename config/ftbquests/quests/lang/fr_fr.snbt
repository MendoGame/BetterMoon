	quest.1900376E2D5A675C.title: "Obtenir toute les cartes de la generation 7"
	quest.1F6B26C3A9F10E5F.title: "Obtenir toute les cartes de la generation 8"
	quest.234B05F4C1D5937D.quest_desc: [
		"&e&lRecycleur de Cartes&r&e&r"
		""
		"Placez-y les cartes que vous avez en trop pour obtenir de la Poudre de Carte."
		""
		"&e&lPoudre de Carte&r&r"
		""
		"Cette poudre permet de réaliser certains crafts ou de charger un disque de structure de cartes."
		""
		"&e&lDisque de structure de cartes&r&r"
		""
		"Chargez-le avec de la Poudre de Carte ou un Insta-Dex pour augmenter le niveau de rareté de votre prochaine ouverture."
		""
		"&l&eInsta-Dex&r&r"
		""
		"Avec un clic droit sur un Pokémon, vous pouvez charger un disque de structure de cartes."
		""
		"&e&lMoniteur de données + Station de Gradage&r&r"
		""
		"En plaçant le moniteur de données au-dessus de la station de gradage, vous pouvez y placer vos cartes pour les grader."
		""
		"&e&lGard-Dex&r&r"
		""
		"Affiche l’avancée de votre collection."
	]
	quest.234B05F4C1D5937D.quest_subtitle: "Tuto"
	quest.234B05F4C1D5937D.title: "Collectionneur"
	quest.27E762AAB904C5C4.quest_desc: [
