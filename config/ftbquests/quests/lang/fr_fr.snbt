	quest.27E762AAB904C5C4.title: "Tristesse"
	quest.28C19269B4B97BA4.quest_desc: [
		"En ouvrant des boosters, vous obtiendrez des cartes qui vous attribueront différents bonus en fonction de leur rareté."
		""
		"&l&nNiveaux de rareté&r: &7commun&f, &8peu commun&f, &arare&f, &9épique&f, &6légendaire&f et &cmythique&f."
		""
		"&l&nBonus disponible&r: &avitesse de minage&r&f, &avitesse de déplacement&r&f, &adégats d'attaque&f, &achance&f, &aarmure&f, &asanté max&f et &amultiplicateurs de taux de spawn des pokémons&f."
		""
		"Vous pouvez augmenter les bonus de vos cartes en les gradant de &a1&f à &a10&f."
	]
	quest.28C19269B4B97BA4.quest_subtitle: "Tuto"
	quest.28C19269B4B97BA4.title: "Info"
